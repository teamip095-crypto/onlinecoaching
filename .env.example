# Copy this file to .env and fill in real values
# NEVER commit .env to git

DATABASE_URL=file:./db/custom.db
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32

# Optional: Set this email to become SUPER_ADMIN (otherwise first signup becomes admin)
# SUPER_ADMIN_EMAIL=you@example.com

# WhatsApp Business API (for sending invoices + OTPs)
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
# WHATSAPP_TOKEN=your_whatsapp_business_token
# WHATSAPP_TEMPLATE_NAME=invoice_otp

# Supabase (optional, for production database)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
